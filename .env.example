# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Broker selection: paper | angel_one | kite ---
BROKER_PROVIDER=paper

# --- Angel One SmartAPI ---
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# --- Arbitrage risk limits (INR); live execution is not currently supported ---
LIVE_TRADING_ENABLED=false
# Set only after reviewing arbitrage_tracking.md and testing in a broker sandbox.
LIVE_TRADING_ACKNOWLEDGEMENT=
ARBITRAGE_MAX_EXPOSURE_INR=300
ARBITRAGE_MAX_DAILY_LOSS_INR=60
ARBITRAGE_MAX_FALLBACK_LOSS_INR=30

# --- Zerodha Kite Connect (future) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=quant_trader
POSTGRES_USER=quant_trader
POSTGRES_PASSWORD=change_me

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=quant_trader
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Security ---
JWT_SECRET_KEY=change_me_dev_only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CREDENTIAL_ENCRYPTION_KEY=

# --- Risk defaults ---
MAX_DAILY_LOSS=25000
MAX_POSITION_SIZE=100000
MAX_ORDER_QUANTITY=1000
