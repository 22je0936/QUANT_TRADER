# Application
APP_ENV=development
LOG_LEVEL=INFO

# Angel One SmartAPI credentials
ANGEL_ONE_API_KEY=replace_with_your_api_key
ANGEL_ONE_CLIENT_ID=replace_with_your_client_id
ANGEL_ONE_PASSWORD=replace_with_your_password_or_pin
ANGEL_ONE_TOTP_SECRET=replace_with_your_totp_secret

# Live arbitrage is disabled unless explicitly enabled and acknowledged.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACKNOWLEDGEMENT=
ARBITRAGE_MAX_EXPOSURE_INR=300
ARBITRAGE_MAX_DAILY_LOSS_INR=60
ARBITRAGE_MAX_FALLBACK_LOSS_INR=30

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=quant_trader
POSTGRES_USER=quant_trader
POSTGRES_PASSWORD=change_me

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=quant_trader
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API security settings
JWT_SECRET_KEY=change_me_dev_only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CREDENTIAL_ENCRYPTION_KEY=

# General order risk limits
MAX_DAILY_LOSS=25000
MAX_POSITION_SIZE=100000
MAX_ORDER_QUANTITY=1000